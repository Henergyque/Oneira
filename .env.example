# Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application ID
CLIENT_ID=your_client_id_here

# Your Discord Server (Guild) ID
GUILD_ID=your_server_id_here

# Channel IDs for announcements
DEVLOG_CHANNEL_ID=your_devlog_channel_id
ANNOUNCEMENTS_CHANNEL_ID=your_announcements_channel_id

# Role IDs
MEMBER_ROLE_ID=your_member_role_id

# Patreon tier role IDs (optional)
PATREON_TIER1_ID=
PATREON_TIER2_ID=
PATREON_TIER3_ID=

# Telemetry API (Railway)
TELEMETRY_API_URL=https://your-server.railway.app
ADMIN_TOKEN=your_admin_token

# Zone progression roles
ROLE_INTRO_ID=
ROLE_JEU1_ID=
ROLE_JEU2_ID=
ROLE_ENDGAME_ID=
